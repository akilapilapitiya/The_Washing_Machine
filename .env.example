# The Washing Machine - Environment Variables Template
# Copy this file to .env and fill in your values

# ============================================
# DATABASE CONFIGURATION
# ============================================
DB_HOST=postgres
DB_PORT=5432
DB_NAME=washing_machine
DB_USER=postgres
DB_PASSWORD=your_secure_database_password_here

# ============================================
# AUTHENTICATION
# ============================================
# IMPORTANT: Generate a strong, random JWT secret for production
# You can use: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your_secure_jwt_secret_key_minimum_32_characters_long
SALT_ROUNDS=10

# ============================================
# EMAIL CONFIGURATION (Nodemailer)
# ============================================
# For Gmail: Use App Password, not regular password
# Enable 2FA and generate at: https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password_here

# ============================================
# FRONTEND URL (for CORS)
# ============================================
# Use your Ubuntu server's local IP address
# Example: http://192.168.1.100
FRONTEND_URL=http://YOUR_SERVER_IP

# ============================================
# FRONTEND API URL
# ============================================
# This should point to your backend server
# Example: http://192.168.1.100:5000/api
VITE_API_BASE_URL=http://YOUR_SERVER_IP:5000/api
