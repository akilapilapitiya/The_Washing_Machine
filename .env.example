# ==========================================
# UNIFIED ENVIRONMENT VARIABLE TEMPLATE
# ==========================================

# ------------------------------------------
# BACKEND CONFIGURATION
# ------------------------------------------
NODE_ENV=production
PORT=5500

# Database Control
DB_USER=admin
DB_HOST=db
DB_NAME=the-washing-machine
DB_PORT=5432
DB_PASSWORD=your_secure_password

# JWT Auth
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=1d

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# Telegram (Optional)
TELEGRAM_BOT_TOKEN=
ENABLE_TELEGRAM_BOT=false

# CORS (Crucial for Deployment)
# Set this to your frontend IP/Domain
CORS_ORIGIN=http://your-ec2-ip

# ------------------------------------------
# FRONTEND CONFIGURATION (Vite)
# ------------------------------------------
# This must be "baked" into the build via Build Args or GitLab Variables
VITE_API_BASE_URL=http://your-ec2-ip:5500/api
