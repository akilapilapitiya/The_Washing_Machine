NODE_ENV = 'development'
PORT = 5500

# Rate Limiting (disabled in development by default)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_AUTH_MAX=5

# Database Control
DB_USER=postgres
DB_HOST=db
DB_NAME=washing_machine
DB_PORT=5432
DB_PASSWORD=postgres

# Redis Config (for Docker)
REDIS_URL=redis://redis:6379

# JWT Auth
JWT_SECRET=""
JWT_EXPIRES_IN="1d"

#Cookie Age
COOKIE_AGE = 7

#Password Hasing 
SALT_ROUNDS=12

# Password Reset OTP (in minutes)
OTP_EXPIRES_IN_MINUTES=10

# Gmail SMTP Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your_gmail@gmail.com
SMTP_PASS=paste_your_16_char_app_password_here

# Telegram Bot
TELEGRAM_BOT_TOKEN=